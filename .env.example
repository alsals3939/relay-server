# PUBLIC TEMPLATE ONLY — replace all placeholders locally, never commit .env
PORT=3001
CLIENT_ORIGIN=http://localhost:3000
ADMIN_ORIGIN=http://localhost:3002
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5434/YOUR_DATABASE?schema=public
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_IN_YOUR_LOCAL_ENV
JWT_EXPIRES_IN=7d
AI_PROVIDER=openai
OPENAI_API_KEY=
# For local MLX instead of OpenAI, set AI_PROVIDER=mlx and configure below:
# AI_BASE_URL=http://127.0.0.1:8080/v1
# AI_API_KEY=LOCAL_ONLY_PLACEHOLDER
# AI_DEFAULT_MODEL=default_model
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=REPLACE_WITH_A_UNIQUE_PASSWORD_OF_AT_LEAST_12_CHARS
SUPERADMIN_NAME=Demo Admin
